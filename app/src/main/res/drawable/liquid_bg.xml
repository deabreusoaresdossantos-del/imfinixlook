<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#5CBFD9FF" android:endColor="#22FFD6F0" />
            <stroke android:width="1.2dp" android:color="#99FFFFFF" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item android:height="38dp" android:gravity="top" android:left="4dp" android:right="4dp" android:top="3dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#73FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="27dp" android:topRightRadius="27dp" android:bottomLeftRadius="14dp" android:bottomRightRadius="14dp" />
        </shape>
    </item>
    <item android:height="26dp" android:gravity="bottom" android:left="10dp" android:right="10dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#40FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
