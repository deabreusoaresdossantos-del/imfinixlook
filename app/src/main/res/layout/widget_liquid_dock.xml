<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:padding="10dp"
    android:background="@drawable/liquid_bg">
    <TextView android:id="@+id/dock_camera" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_margin="4dp" android:gravity="center" android:text="📷" android:textSize="24sp" android:background="@drawable/liquid_tile" />
    <TextView android:id="@+id/dock_settings" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_margin="4dp" android:gravity="center" android:text="⚙️" android:textSize="24sp" android:background="@drawable/liquid_tile" />
    <TextView android:id="@+id/dock_phone" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_margin="4dp" android:gravity="center" android:text="📞" android:textSize="24sp" android:background="@drawable/liquid_tile" />
    <TextView android:id="@+id/dock_web" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_margin="4dp" android:gravity="center" android:text="🌐" android:textSize="24sp" android:background="@drawable/liquid_tile" />
</LinearLayout>
