<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp"
    android:background="@drawable/liquid_bg">
    <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:format12Hour="HH:mm" android:format24Hour="HH:mm" android:textSize="54sp" android:textStyle="bold" android:textColor="#FFFFFF" />
    <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:format12Hour="EEEE, d 'de' MMMM" android:format24Hour="EEEE, d 'de' MMMM" android:textSize="13sp" android:textColor="#E6FFFFFF" />
</LinearLayout>
