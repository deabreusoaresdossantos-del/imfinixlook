<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ImfinixLook">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".QuickSettingsActivity" android:exported="false" />
        <activity android:name=".QuickPanelActivity" android:exported="false" />
        <activity android:name=".LockScreenActivity" android:exported="false" />
        <activity android:name=".WallpapersActivity" android:exported="false" />
        <activity android:name=".ClockStylesActivity" android:exported="false" />
        <activity android:name=".SoundProfilesActivity" android:exported="false" />
        <activity android:name=".GesturesActivity" android:exported="false" />
        <activity android:name=".ThemesActivity" android:exported="false" />
        <activity android:name=".NotificationHistoryActivity" android:exported="false" />
        <activity android:name=".TipsActivity" android:exported="false" />

        <service
            android:name=".NotificationLogService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".ClockWidgetProvider"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/clock_widget_info" />
        </receiver>

        <receiver
            android:name=".ClockWidgetThinProvider"
            android:exported="false"
            android:label="@string/widget_thin_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/clock_widget_thin_info" />
        </receiver>

        <receiver
            android:name=".ClockWidgetAccentProvider"
            android:exported="false"
            android:label="@string/widget_accent_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/clock_widget_accent_info" />
        </receiver>
    </application>
</manifest>
